{
  "cleanUrls": true,
  "buildCommand": "cd frontend/motion && npm ci && npm run build",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://lucazhou-suno2mv-api.hf.space/api/:match*"
    },
    {
      "source": "/lyric-editor/:match*",
      "destination": "/lyric-editor.html"
    },
    {
      "source": "/motion-lab.css",
      "destination": "/local/motion-lab.css"
    },
    {
      "source": "/motion/:match*",
      "destination": "/local/motion/:match*"
    },
    {
      "source": "/static/:match*",
      "destination": "/local/:match*"
    }
  ],
  "outputDirectory": "frontend"
}
