# ============================================================
# M2V 环境变量配置
# 复制此文件为 .env 并修改
# ============================================================

# ── 通用 ──────────────────────────────────────────────────
DEBUG=false
# 生产环境请更换为随机字符串: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-in-production-use-openssl-rand-hex-32

# ── 数据库 ────────────────────────────────────────────────
# 本地开发 (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./m2v.db
# 生产部署 (Supabase PostgreSQL，支持 IPv4 + 会话池):
# DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# 传统自建 PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://m2v:password@localhost:5432/m2v

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT ───────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── 文件存储 ──────────────────────────────────────────────
# "local" 或 "s3" 或 "r2"
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output

# Cloudflare R2 (STORAGE_BACKEND=r2，免出网流量费，S3 协议兼容):
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=suno2mv-media
# R2_PUBLIC_DOMAIN=https://media.yourdomain.com  # 可选: 自定义域名，不填则自动生成临时预签名链接

# 标准 S3 / MinIO (STORAGE_BACKEND=s3 时启用):
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=m2v
# S3_REGION=us-east-1

# ── 用户配额与初始赠送 ──────────────────────────────────
# 新用户注册赠送永久积分（永久有效不设到期）
NEW_USER_PERMANENT_CREDITS=100
# 初始永久积分消耗完毕后，免费用户每月免费额度
FREE_MONTHLY_QUOTA=20
PRO_MONTHLY_QUOTA=100
MAX_UPLOAD_SIZE_MB=50

# ── 服务 ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Suno 授权 (可选，用于私密歌曲/新生成歌曲自动静默下载) ──────
# 在浏览器登录 suno.com，F12 打开控制台并在 Network 中复制 studio-api.prod.suno.com 请求的 Cookie 或 Bearer Token
# SUNO_COOKIE="__client=...; ..."
# SUNO_TOKEN="ey..."


# ── Motion Studio / Gemini 动效导演（仅后端读取） ──────────
GEMINI_API_KEY=
M2V_LLM_MODEL=gemini-3.8-flash
# 主模型 HTTP 429 时切换一次；留空可关闭自动切换
M2V_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
M2V_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
M2V_LLM_TIMEOUT=180
M2V_LLM_MAX_TOKENS=16384
M2V_LLM_JSON_MODE=true

# Shared database-backed render capacity (all backend processes use one DB)
MAX_CONCURRENT_RENDERS_PER_USER=2
MAX_GLOBAL_CONCURRENT_RENDERS=4
# Comma-separated authenticated user IDs. Empty disables the admin backup API.
M2V_ADMIN_USERS=

# Lemon Squeezy (payment branch only; keep disabled until staging acceptance)
BILLING_ENABLED=false
# Select lemonsqueezy (default) or stripe. Stripe currently supports sandbox only.
BILLING_PROVIDER=lemonsqueezy
# Put credentials in backend Secrets only, never in Pages variables or source code.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_TEST_MODE=true
STRIPE_PORTAL_CONFIGURATION_ID=
# Enable only after checking Tax Settings, product tax codes and active registrations.
STRIPE_AUTOMATIC_TAX=false
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_TEST_MODE=true
# Set true ONLY on a staging deployment with a separate database.
BILLING_ALLOW_TEST_TRANSACTIONS=false
# Exact hostnames, e.g. your-store.lemonsqueezy.com,app.lemonsqueezy.com
LEMONSQUEEZY_ALLOWED_HOSTS=
BILLING_SITE_URL=https://mv.fovea.si
# JSON catalogue; prices and credits are set by the operator, never the client.
# Unified global USD tiers: Pro Monthly ($9.99/mo, 600 credits), Studio Matrix ($24.99/mo, 2500 credits), Top-Up ($4.99, 200 credits)
BILLING_PRODUCTS_JSON=[{"id":"topup_200","name":"Credit Top-Up (200 Credits)","variant_id":"101","kind":"topup","credits":200,"price_cents":499,"currency":"USD"},{"id":"pro_monthly","name":"Creator Pro (600 Credits/mo)","variant_id":"102","kind":"subscription","credits":600,"price_cents":999,"currency":"USD"},{"id":"studio_monthly","name":"Studio Matrix (2,500 Credits/mo)","variant_id":"103","kind":"subscription","credits":2500,"price_cents":2499,"currency":"USD"}]

# Credits charged per authenticated Motion Design video (one matrix cell).
# MOTION_WEBCODECS_CREDITS: local WebCodecs GPU fast export (defaults to 10)
# MOTION_EXPORT_CREDITS: cloud headless Chromium render fallback (defaults to 10)
# Set to 0 to keep exports free during development/testing.
MOTION_WEBCODECS_CREDITS=10
MOTION_EXPORT_CREDITS=10
