{
  "manifest_version": 3,
  "name": "Fovea MV - Suno 歌词视频助手",
  "version": "1.0.2",
  "description": "在 Suno 网页听歌时一键抓取音频与歌词，免除 25 首下载配额限制，秒级生成 9:16 动效短视频与时间轴。",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://suno.com/*",
    "*://*.suno.com/*",
    "*://*.suno.ai/*",
    "*://*.cloudfront.net/*",
    "*://*.amazonaws.com/*",
    "https://*.fovea.si/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fovea MV 动效视频助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://suno.com/*",
        "*://*.suno.com/*"
      ],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://suno.com/*",
        "*://*.suno.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
