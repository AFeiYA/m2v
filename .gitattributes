# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows batch scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts keep LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.m4a binary
*.flac binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
