{
  "hosting": {
    "public": "frontend",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "node_modules/**",
      "motion/node_modules/**",
      "motion/**/node_modules/**",
      "motion/src/**",
      "motion/scripts/**"
    ],
    "rewrites": [
      {
        "source": "/editor/**",
        "destination": "/editor.html"
      },
      {
        "source": "/editor",
        "destination": "/editor.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
