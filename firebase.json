{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "hosting": {
    "public": "frontend",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "node_modules/**",
      "motion/node_modules/**",
      "motion/**/node_modules/**",
      "motion/src/**",
      "motion/scripts/**",
      "local/*.html"
    ],
    "rewrites": [
      {
        "source": "/lyric-editor/**",
        "destination": "/lyric-editor.html"
      }
    ]
  }
}
