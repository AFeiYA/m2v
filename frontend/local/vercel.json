{
  "cleanUrls": true,
  "buildCommand": "cd ../motion && npm ci && npm run build",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://lucazhou-suno2mv-api.hf.space/api/:match*"
    },
    {
      "source": "/motion_studio",
      "destination": "/motion_studio_director.html"
    },
    {
      "source": "/motion",
      "destination": "/motion_studio_director.html"
    },
    {
      "source": "/motion_lab",
      "destination": "/motion_lab.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/videos",
      "destination": "/gallery.html"
    },
    {
      "source": "/storyboard",
      "destination": "/storyboard.html"
    },
    {
      "source": "/static/:match*",
      "destination": "/:match*"
    }
  ],
  "outputDirectory": "."
}
